{
  "name": "bouncer",
  "private": true,
  "type": "module",
  "description": "The open-source token door-guy for Claude Code.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @bouncer/core && npm run build -w @bouncer/cli -w bouncer-vscode",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @bouncer/cli",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.17"
  }
}
